# Shared environment — copy to .env and fill in values

# Backend database
DATABASE_URL=postgresql://cyberassetiq:changeme@db:5432/cyberassetiq

# Default tenant for bootstrap key creation at startup
CYBERASSETIQ_DEFAULT_TENANT=tenant-001

# Bootstrap API key — if set, this exact value is used as the admin key for the default tenant.
# Leave blank to auto-generate (key will be printed to logs on first startup).
CYBERASSETIQ_BOOTSTRAP_KEY=

# NVD API key (optional — raises rate limit from 5/30s to 50/30s)
# Register free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# NVD result cache TTL in seconds (default: 86400 = 24h)
NVD_CACHE_TTL=86400

# Default agent collection policy (JSON)
DEFAULT_POLICY_JSON={"collection":{"software":true,"security":true,"network":true,"secret_scan":true},"updater":{"enabled":false}}

# SecretScore ML model path and confidence threshold
SECRETSCORE_MODEL_PATH=/tmp/cyberassetiq_secretscore.pkl
SECRETSCORE_THRESHOLD=0.55

# Agent command poll interval in seconds
CYBERASSETIQ_COMMAND_POLL_INTERVAL=60
